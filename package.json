{
	"name": "@buape/messagekit",
	"version": "0.1.0",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"devDependencies": {
		"@types/react": "19",
		"typescript": "5",
		"react": "19.1.0"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		}
	},
	"bugs": "https://github.com/buape/messagekit-sdk/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buape/messagekit-sdk.git"
	},
	"description": "Embed the MessageKit Discord message composer in JavaScript apps, with optional React components and hooks.",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"homepage": "https://www.messagekit.app",
	"keywords": [
		"messagekit",
		"discord",
		"composer",
		"react",
		"sdk"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepack": "bun run build"
	},
	"type": "module",
	"types": "./dist/index.d.ts",
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
